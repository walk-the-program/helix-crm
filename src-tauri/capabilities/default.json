{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least privilege for the Helix main window. The frontend can read and write inside the app data folder and nowhere else; it can open the kinds of link a CRM needs and files inside a workspace; it can reach the Anthropic API and no other host. Everything else the app does (SQLite, the site poll, the keychain, attachment copies) runs behind a Rust command, where the path or the origin is chosen in Rust rather than supplied by JS.",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",

    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "fs:create-app-specific-dirs",

    "dialog:allow-open",
    "dialog:allow-save",

    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "mailto:*" },
        { "url": "tel:*" },
        { "url": "sms:*" }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA/workspaces/**" }]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "$APPDATA/**" }]
    },

    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.anthropic.com/*" }]
    },

    "log:default",

    "window-state:default"
  ]
}
